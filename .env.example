NODE_ENV=development
# official: production requires mail; self_hosted: features may degrade explicitly.
DEPLOYMENT_MODE=self_hosted

# Public origin / stable OIDC issuer. Keep the production value fixed.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Independent HMAC key for OTP, invitation, device and request-context digests.
SECURITY_HASH_SECRET=replace-with-a-different-32-character-random-secret
# Authorizes the serverless cron / worker that dispatches reliable webhooks.
OUTBOX_WORKER_SECRET=replace-with-another-32-character-random-secret
# Official Hobby: POST this Worker /wake URL after enqueueing outbox rows so
# the minute cron can skip Neon when idle. Must be HTTPS.
# OUTBOX_WAKE_URL=https://hflive-auth-outbox-scheduler.example.workers.dev/wake
# Vercel Cron sets CRON_SECRET and sends it as Bearer auth; use either variable.
# CRON_SECRET=replace-with-vercel-cron-secret

# Use a pooled URL at runtime on serverless platforms.
DATABASE_URL=postgresql://hflive:hflive@localhost:55432/hflive_auth
# Use a direct URL for Prisma CLI migrations in hosted environments.
DIRECT_DATABASE_URL=postgresql://hflive:hflive@localhost:55432/hflive_auth

# Vercel is the safe default. EdgeOne only receives public /_next/static assets.
STATIC_ASSET_PROVIDER=vercel
# EDGEONE_ASSET_ORIGIN=https://static-auth.example.com
# EDGEONE_PROJECT_NAME=hflive-auth-static-eo
# EDGEONE_API_TOKEN=replace-with-a-sensitive-production-token

# Comma-separated exact origins allowed to call the auth service.
TRUSTED_ORIGINS=http://localhost:3000

# Transactional mail. SMTP defaults target local Mailpit; official production should use HTTP.
MAIL_ENABLED=false
MAIL_FROM=HFLive Auth <auth@hsfz.live>
MAIL_TRANSPORT=smtp
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=51025
MAIL_SMTP_SECURE=false
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=
# MAIL_API_URL=https://mail-provider.example/v1/send
# MAIL_API_TOKEN=replace-me

# Phase 5: S3-compatible avatar storage (R2 in production, MinIO locally).
OBJECT_STORAGE_ENABLED=false
S3_ENDPOINT=http://localhost:59000
S3_REGION=auto
S3_BUCKET=hflive-auth
S3_ACCESS_KEY_ID=hflive
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=true
# Compose app only: override when the container should use external S3/R2.
# APP_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
