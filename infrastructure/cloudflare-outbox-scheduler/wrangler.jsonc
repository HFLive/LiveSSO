{
  "name": "hflive-auth-outbox-scheduler",
  "main": "worker.js",
  "compatibility_date": "2026-08-09",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "AUTH_ORIGIN": "https://auth.hsfz.live"
  },
  // After `npx wrangler kv namespace create OUTBOX_PENDING`, bind the id here
  // so the minute cron can skip Neon when the pending flag is absent:
  // "kv_namespaces": [{ "binding": "OUTBOX_PENDING", "id": "<kv-namespace-id>" }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
