{
  "name": "hflive-auth-outbox-scheduler",
  "main": "worker.js",
  "compatibility_date": "2026-08-09",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "AUTH_ORIGIN": "https://auth.hsfz.live"
  },
  "kv_namespaces": [
    {
      "binding": "OUTBOX_PENDING",
      "id": "a90eda960d2e49d2b645b82fd68ece55"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
